# ---------------------------------------------------------------------------
# Copy to `.env.local` for local work, and set the same keys in
# Vercel → Settings → Environment Variables for Preview and Production.
# This file is the template only: it is committed and never read at runtime.
# ---------------------------------------------------------------------------

# Canonical origin. Drives canonical URLs, hreflang, sitemap.xml, robots.txt
# and every Open Graph tag. Set this in Vercel → Settings → Environment
# Variables for Production, or shared links will point at the wrong host.
NEXT_PUBLIC_SITE_URL=https://menusyria.com

# The backend the app talks to.
#
# THIS ONE IS A SWITCH, not just an address: `lib/api/client.ts` treats an
# empty value as "no backend yet" and serves every screen from `lib/mock/data`.
# The moment it holds a URL, every service stops mocking and calls that host.
#
# Note the base is the DOMAIN ROOT, with no /api segment: that path serves the
# Swagger UI page, while the endpoints themselves sit at the root
# (/auth/me, /offers/featured, /locations/governorates ...). The OpenAPI spec
# is at https://menusyria.softup.agency/api-json.
#
# No trailing slash: service paths already start with one.
NEXT_PUBLIC_API_URL=https://menusyria.softup.agency

# Google Maps embed key used by the storefront location panel and the
# registration map picker. Restrict it by HTTP referrer to your domains.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Firebase Web push (real browser notifications). From Firebase console →
# Project settings → General → Your apps → the Web app's config object,
# plus the VAPID key from Project settings → Cloud Messaging → Web
# configuration → "Web Push certificates". Not secret — these are public
# client identifiers — but the service worker at
# public/firebase-messaging-sw.js can't read env vars, so its own copy of
# these same values has to be kept in sync by hand if the project changes.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
